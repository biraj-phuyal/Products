{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "products",
  "compatibility_date": "2026-06-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS"
  },
  "vars": {
    "VITE_API_URL": "https://products-ub2ju.sevalla.app/api",
    },
    "workers_dev": false,
  "compatibility_flags": [
    "nodejs_compat"
  ]
}